# Get a free key at https://highlightly.net/login (100 req/day free tier)
HIGHLIGHTLY_API_KEY=your_key_here

# "direct" (highlightly.net account) or "rapidapi" (RapidAPI account)
HIGHLIGHTLY_SOURCE=direct

# UEFA Champions League league ID on Highlightly.
# Documented id is often 2486 — confirm with:
#   curl "https://soccer.highlightly.net/leagues?name=UEFA%20Champions%20League" \
#     -H "x-rapidapi-key: YOUR_KEY"
# The app falls back to 2486 if this is empty.
UCL_LEAGUE_ID=2486
