# Get a free key at https://highlightly.net/login (100 req/day free tier)
HIGHLIGHTLY_API_KEY=your_key_here

# "direct" (highlightly.net account) or "rapidapi" (RapidAPI account)
HIGHLIGHTLY_SOURCE=direct

# UEFA Champions League's numeric league ID from Highlightly.
# Look this up once — see README "Find the Champions League ID".
UCL_LEAGUE_ID=
